# Frontend environment (dev)
# Angular reads these from src/environments/environment.ts at build time.
# Edit that file directly — there is no runtime .env loader for the browser bundle.
#
# apiBaseUrl=http://127.0.0.1:3000/api
# spotifyClientId=YOUR_SPOTIFY_CLIENT_ID
# spotifyRedirectUri=http://127.0.0.1:5173/spotify-user
